# ═══════════════════════════════════════════════════════════════════════════
# Umbra — variáveis de ambiente
# Local: copie para `.env`. Vercel: cadastre em Project → Settings →
# Environment Variables. NUNCA versione o arquivo `.env`.
# Guia completo: DEPLOY-VERCEL-SUPABASE.md
# ═══════════════════════════════════════════════════════════════════════════

# ── Aplicação ───────────────────────────────────────────────────────────────
# URL pública sem barra final (links de e-mail, webhooks, retorno do gateway).
# Na Vercel, se ficar vazia, usa automaticamente o domínio de produção do projeto.
APP_URL="http://localhost:3000"

# Modo demonstração: gateway "mock", botões de simulação e faixa "Modo Demo".
# Em produção com clientes reais use "false".
DEMO_MODE="true"

# ── Banco de dados (Supabase / PostgreSQL) ──────────────────────────────────
# Supabase → Project Settings → Database → Connection string.
# DATABASE_URL: "Transaction pooler" (porta 6543) + ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL: "Session pooler" (porta 5432) — usada só pelas migrations.
DIRECT_URL="postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ── Segurança ───────────────────────────────────────────────────────────────
# Mínimo 32 caracteres aleatórios:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# 32 bytes em base64 (criptografa credenciais do gateway, CPF e 2FA).
# Se trocar depois, os dados já criptografados deixam de ser legíveis.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

SESSION_TTL_DAYS="14"

# A Vercel envia este valor no header Authorization ao chamar o cron (vercel.json).
CRON_SECRET=""

# "database" (padrão em produção) compartilha o rate limit entre as funções
# serverless; "memory" só serve para um único processo.
RATE_LIMIT_STORE="database"

# ── Armazenamento de mídia ──────────────────────────────────────────────────
# "supabase" → Supabase Storage (recomendado na Vercel)
# "s3"       → AWS S3, Cloudflare R2, Backblaze B2, Wasabi, MinIO
# "local"    → disco (apenas desenvolvimento; NÃO funciona na Vercel)
STORAGE_DRIVER="supabase"

# Supabase → Project Settings → API. A chave de serviço é SECRETA: só no servidor.
SUPABASE_URL="https://SEU_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PRIVATE_BUCKET="umbra-private"
SUPABASE_PUBLIC_BUCKET="umbra-public"

STORAGE_LOCAL_DIR="./storage"

S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
S3_PUBLIC_CDN_URL=""

# Limites de upload (MB). No Supabase Free o limite global por arquivo é 50 MB;
# no Pro ajuste em Storage → Settings e aumente MAX_VIDEO_MB.
MAX_IMAGE_MB="20"
MAX_VIDEO_MB="50"
SIGNED_URL_TTL_SECONDS="900"

# ── Pagamentos ──────────────────────────────────────────────────────────────
# Gateway e credenciais são configurados no painel (Configurações → Pagamentos)
# e salvos criptografados no banco. Abaixo, apenas fallback.
PAYMENT_GATEWAY="mock"          # mock | asaas | mercadopago
PAYMENT_MODE="sandbox"          # sandbox | production
PAYMENT_API_KEY=""
PAYMENT_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET="demo-webhook-secret"

# ── E-mail ──────────────────────────────────────────────────────────────────
EMAIL_DRIVER="console"          # console | smtp
EMAIL_FROM="Umbra <nao-responda@exemplo.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# ── Primeiro administrador (npm run admin:create / seed) ────────────────────
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@umbra.local"
ADMIN_PASSWORD="Admin@12345678"
